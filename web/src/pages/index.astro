---
import "../styles/global.css";

const wordmark = ` ▄▄    ▄▄  ▄▄▄▄▄▄▄▄  ▄▄▄▄▄▄▄▄  ▄▄▄▄▄▄      ▄▄▄▄    ▄▄▄▄▄     ▄▄▄▄▄▄▄▄  ▄▄    ▄▄
 ██    ██  ▀▀▀██▀▀▀  ▀▀▀██▀▀▀  ██▀▀▀▀█▄  ▄█▀▀▀▀█   ██▀▀▀██   ██▀▀▀▀▀▀  ▀██  ██▀
 ██    ██     ██        ██     ██    ██  ██▄       ██    ██  ██         ██  ██
 ████████     ██        ██     ██████▀    ▀████▄   ██    ██  ███████    ██  ██
 ██    ██     ██        ██     ██             ▀██  ██    ██  ██          ████
 ██    ██     ██        ██     ██        █▄▄▄▄▄█▀  ██▄▄▄██   ██▄▄▄▄▄▄    ████
 ▀▀    ▀▀     ▀▀        ▀▀     ▀▀         ▀▀▀▀▀    ▀▀▀▀▀     ▀▀▀▀▀▀▀▀    ▀▀▀▀`;

const installCmd = "go install github.com/ArpitRajputGithub/httpsdev@latest";
const repo = "https://github.com/ArpitRajputGithub/httpsdev";

const features = [
  {
    icon: "ti-shield-check",
    title: "No self-signed drama",
    body: "Certs come from mkcert — the same local CA Chrome and Safari already trust. Zero warnings. Zero “Advanced → Proceed anyway” clicking.",
  },
  {
    icon: "ti-settings-2",
    title: "No framework-specific config",
    body: "No --https flag to remember. No HTTPS=true env var. No experimental Next config. Point at a port and go.",
  },
  {
    icon: "ti-bolt",
    title: "HMR still works",
    body: "WebSocket upgrades and SSE forward untouched. Your Vite HMR, Next dev overlay, Rails Turbo streams — everything keeps working.",
  },
  {
    icon: "ti-cpu",
    title: "One binary, no runtime",
    body: "10 MB static Go binary. No node_modules. No Python venv. No Docker. go install and you're done.",
  },
];

const requests = [
  { method: "GET", path: "/", status: "200", ms: "6ms", ok: true },
  { method: "GET", path: "/@vite/client", status: "200", ms: "3ms", ok: true },
  { method: "GET", path: "/favicon.ico", status: "404", ms: "5ms", ok: false },
  { method: "POST", path: "/api/login", status: "401", ms: "45ms", ok: false },
  { method: "GET", path: "/src/App.tsx", status: "200", ms: "2ms", ok: true },
  { method: "GET", path: "/api/session", status: "200", ms: "1ms", ok: true },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>httpsdev — Real HTTPS for any local dev server</title>
    <meta
      name="description"
      content="Zero-config HTTPS wrapper for local dev servers. Real browser-trusted certs via mkcert. Works with Vite, Next, Rails, Django — any HTTP dev server."
    />
    <meta property="og:title" content="httpsdev — Real HTTPS for any local dev server" />
    <meta
      property="og:description"
      content="Zero-config HTTPS wrapper for local dev servers. Real browser-trusted certs via mkcert. Works with any HTTP dev server."
    />
    <meta property="og:type" content="website" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&family=Work+Sans:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.31.0/dist/tabler-icons.min.css"
      rel="stylesheet"
    />
    <!--
      GoatCounter analytics (privacy-friendly, cookie-free).
      Sign up at goatcounter.com, create a site named "httpsdev",
      then replace the code below with your site code (the subdomain).
      Comment out or delete these lines to disable analytics.
    -->
    <script
      data-goatcounter="https://YOUR-CODE.goatcounter.com/count"
      async
      src="//gc.zgo.at/count.js"
    ></script>
  </head>
  <body class="antialiased">
    <div class="mx-auto w-full max-w-[1440px] lg:grid lg:grid-cols-[300px_minmax(0,1fr)]">
      <!-- Sidebar / top bar -->
      <header
        class="flex items-center justify-between gap-4 border-b border-subtle px-6 py-5 lg:sticky lg:top-0 lg:h-screen lg:flex-col lg:items-stretch lg:justify-start lg:border-b-0 lg:border-r lg:px-8 lg:py-10"
      >
        <a href="/" class="flex items-center gap-2 font-mono text-sm font-semibold tracking-wider text-accent">
          <span aria-hidden="true">▶</span>
          <span>httpsdev</span>
        </a>

        <!-- Mobile nav: compact links + icon-only repo button -->
        <nav class="flex items-center gap-5 text-xs text-muted lg:hidden" aria-label="Primary">
          <a href="#install" class="hover:text-text">install</a>
          <a href="#features" class="hover:text-text">features</a>
          <a
            href={repo}
            class="flex h-8 w-8 items-center justify-center rounded-md border border-subtle text-muted transition hover:border-accent hover:text-accent"
            aria-label="Star httpsdev on GitHub"
          >
            <i class="ti ti-star text-base" aria-hidden="true"></i>
          </a>
        </nav>

        <!-- Desktop sidebar nav -->
        <nav class="mt-14 hidden flex-col gap-1 font-sans text-sm lg:flex" aria-label="Primary">
          <a
            href="#install"
            class="-mx-3 rounded-md px-3 py-2 text-muted transition hover:bg-surface hover:text-text"
            >Install</a
          >
          <a
            href="#features"
            class="-mx-3 rounded-md px-3 py-2 text-muted transition hover:bg-surface hover:text-text"
            >Features</a
          >
          <a
            href={repo}
            class="mt-4 inline-flex w-fit items-center gap-2 rounded-md border border-subtle px-3 py-1.5 text-muted transition hover:border-accent hover:text-accent"
          >
            <span>github</span>
            <span aria-hidden="true">★</span>
          </a>
        </nav>

        <p class="mt-auto hidden pt-10 font-mono text-xs leading-relaxed text-dim lg:block">
          MIT · Go + bubbletea<br />
          by <a href="https://arpitrajput.xyz" class="underline decoration-subtle underline-offset-2 hover:text-text">Arpit Rajput</a>
        </p>
      </header>

      <!-- Scrolling document column -->
      <main class="px-6 sm:px-10 lg:px-14 xl:px-20">
        <!-- Hero -->
        <section class="pb-20 pt-12 lg:pt-20">
          <pre
            class="wordmark-anim w-full overflow-x-auto text-[8px] leading-[1.05] text-accent sm:text-[10px] lg:text-[11px] xl:text-[13px]"
            aria-label="HTTPSDEV"
          >{wordmark}</pre>

          <h1
            class="mt-10 max-w-2xl font-sans text-4xl font-semibold leading-[1.05] tracking-tight text-text sm:text-5xl lg:text-6xl"
          >
            Localhost with a<br />working padlock.
          </h1>
          <p class="mt-6 font-sans text-lg text-text sm:text-xl">
            Point it at a port. Get a green padlock.
          </p>
          <p class="mt-6 max-w-xl font-sans text-sm leading-relaxed text-muted sm:text-base">
            Every framework has its own broken HTTPS story. Some ship self-signed certs that trip the
            browser. Some hide it behind an <code class="text-text">HTTPS=true</code> env var. Some just don't.
            <span class="text-text">httpsdev</span> sits in front of any dev server and gives it a real, browser-trusted cert.
          </p>
          <p class="mt-4 max-w-xl font-sans text-sm leading-relaxed text-muted sm:text-base">
            Vite, Next, Rails, Django, plain HTTP — if it speaks HTTP, this wraps it. WebSockets and
            SSE pass through untouched. HMR keeps working. No plugins, no configs, no <code class="text-text">--insecure</code>.
          </p>

          <!-- Install command -->
          <div class="mt-12 max-w-2xl">
            <p class="mb-3 font-mono text-xs uppercase tracking-[0.2em] text-dim">Install</p>
            <div
              class="flex items-center gap-3 border-b border-subtle pb-3 transition focus-within:border-text"
            >
              <span class="select-none font-mono text-dim" aria-hidden="true">$</span>
              <code
                class="overflow-x-auto whitespace-nowrap font-mono text-sm text-text sm:text-base"
                id="install-cmd">{installCmd}<span
                  class="cursor-blink ml-1 text-accent"
                  aria-hidden="true">▊</span></code
              >
              <button
                id="copy-btn"
                class="ml-auto shrink-0 rounded-md p-1.5 text-muted transition hover:text-accent"
                data-copy={installCmd}
                aria-label="Copy install command"
              >
                <i class="ti ti-clipboard-copy text-lg" aria-hidden="true"></i>
              </button>
            </div>
            <p class="mt-3 font-sans text-xs leading-relaxed text-muted">
              Needs <a
                href="https://github.com/FiloSottile/mkcert"
                class="text-text underline decoration-subtle underline-offset-2 hover:decoration-accent"
                >mkcert</a
              > once — <code class="text-text">brew install mkcert && mkcert -install</code>.
              That's the only setup.
            </p>
          </div>
        </section>

        <!-- Product proof: static terminal window -->
        <section class="pb-24">
          <div
            class="reveal overflow-hidden rounded-xl border border-subtle bg-bg shadow-[0_24px_60px_rgba(0,0,0,0.35)]"
          >
            <!-- Terminal chrome -->
            <div class="flex items-center gap-2 border-b border-subtle bg-surface px-4 py-3">
              <span class="h-3 w-3 rounded-full bg-bad"></span>
              <span class="h-3 w-3 rounded-full bg-warn"></span>
              <span class="h-3 w-3 rounded-full bg-ok"></span>
              <span class="ml-4 font-mono text-xs text-dim">httpsdev --tui 5173</span>
            </div>

            <!-- Request feed -->
            <div class="px-6 py-8 sm:px-10">
              <div class="flex flex-wrap items-center gap-x-4 gap-y-1 font-mono text-sm">
                <span class="text-accent" aria-hidden="true">▶</span>
                <span class="font-semibold text-text">https://localhost:3443</span>
                <span class="text-dim" aria-hidden="true">⇢</span>
                <span class="text-muted">http://localhost:5173</span>
              </div>
              <p class="mt-1 font-mono text-xs text-dim">mkcert · valid 30d</p>

              <div class="mt-8 flex flex-wrap items-center gap-2 whitespace-nowrap font-mono text-sm">
                <span class="text-dim" aria-hidden="true">──</span>
                <span class="font-bold text-text">live</span>
                <span class="text-dim" aria-hidden="true">────────</span>
                <span class="text-text">6 req</span>
                <span class="text-dim">·</span>
                <span class="text-ok">0</span>
                <span class="text-text">err</span>
                <span class="text-dim">·</span>
                <span class="text-text">3ms avg</span>
                <span class="text-dim">·</span>
                <span class="text-text">12s</span>
              </div>

              <div class="mt-4 overflow-x-auto">
                <div class="min-w-[26rem] space-y-1 font-mono text-sm">
                  {
                    requests.map((r) => (
                      <div class="grid grid-cols-[1rem_3.5rem_1fr_2.5rem_3rem] items-center gap-x-3">
                        <span class="text-dim" aria-hidden="true">→</span>
                        <span class="text-text">{r.method}</span>
                        <span class="truncate text-text">{r.path}</span>
                        <span class={r.ok ? "text-ok" : "text-bad"}>{r.status}</span>
                        <span class="text-dim">{r.ms}</span>
                      </div>
                    ))
                  }
                </div>
              </div>

              <div class="mt-6 font-mono text-subtle" aria-hidden="true">─────────────────────────────────────────────</div>
              <div class="mt-4 flex gap-6 font-mono text-sm text-muted">
                <span><span class="text-dim">[c]</span> clear</span>
                <span><span class="text-dim">[q]</span> quit</span>
              </div>
            </div>
          </div>
        </section>

        <!-- Features: crosshair grid -->
        <section id="features" class="scroll-mt-8 pb-24">
          <h2 class="mb-8 font-sans text-2xl font-semibold tracking-tight text-text">
            The pitch, in four lines.
          </h2>
          <div class="grid gap-px overflow-hidden rounded-lg bg-subtle sm:grid-cols-2">
            {
              features.map((f) => (
                <div class="reveal bg-bg p-6 sm:p-8">
                  <i class={`ti ${f.icon} text-xl text-accent`} aria-hidden="true" />
                  <h3 class="mt-4 font-sans text-base font-semibold text-text">{f.title}</h3>
                  <p class="mt-2 font-sans text-sm leading-relaxed text-muted">{f.body}</p>
                </div>
              ))
            }
          </div>
        </section>

        <!-- Install: vertical timeline -->
        <section id="install" class="scroll-mt-8 pb-24">
          <h2 class="mb-10 font-sans text-2xl font-semibold tracking-tight text-text">
            Two commands, then you're done.
          </h2>
          <ol class="space-y-10 border-l border-subtle pl-8">
            <li class="reveal relative">
              <span
                class="absolute -left-11 flex h-6 w-6 items-center justify-center rounded-full border border-subtle bg-bg font-mono text-xs text-muted"
                aria-hidden="true">1</span
              >
              <p class="font-sans text-sm text-muted">Once, ever: get mkcert and trust its local CA.</p>
              <pre
                class="mt-3 overflow-x-auto rounded-md border-l-2 border-accent bg-surface px-4 py-3 font-mono text-sm text-text"><code>brew install mkcert
mkcert -install</code></pre>
            </li>
            <li class="reveal relative">
              <span
                class="absolute -left-11 flex h-6 w-6 items-center justify-center rounded-full border border-subtle bg-bg font-mono text-xs text-muted"
                aria-hidden="true">2</span
              >
              <p class="font-sans text-sm text-muted">Grab httpsdev.</p>
              <pre
                class="mt-3 overflow-x-auto rounded-md border-l-2 border-accent bg-surface px-4 py-3 font-mono text-sm text-text"><code>go install github.com/ArpitRajputGithub/httpsdev@latest</code></pre>
              <p class="mt-2 font-sans text-xs text-muted">
                Or grab a prebuilt binary from
                <a
                  href={`${repo}/releases`}
                  class="text-text underline decoration-subtle underline-offset-2 hover:decoration-accent"
                  >releases</a
                >.
              </p>
            </li>
            <li class="reveal relative">
              <span
                class="absolute -left-11 flex h-6 w-6 items-center justify-center rounded-full border border-subtle bg-bg font-mono text-xs text-muted"
                aria-hidden="true">3</span
              >
              <p class="font-sans text-sm text-muted">Point it at a port. Open the browser.</p>
              <pre
                class="mt-3 overflow-x-auto rounded-md border-l-2 border-accent bg-surface px-4 py-3 font-mono text-sm text-text"><code># in one terminal
npm run dev            <span class="text-dim"># or vite, next dev, rails s, python -m http.server 5173, …</span>

# in another
httpsdev 5173          <span class="text-dim"># https://localhost:3443  →  http://localhost:5173</span></code></pre>
            </li>
          </ol>
        </section>

        <!-- CTA -->
        <section class="pb-24">
          <a
            href={repo}
            class="inline-flex items-center gap-2.5 rounded-md border border-subtle bg-surface px-6 py-3 font-sans text-sm font-semibold text-text transition hover:border-accent hover:text-accent"
          >
            <span>Star on GitHub</span>
            <span aria-hidden="true">★</span>
          </a>
        </section>

        <!-- Footer -->
        <footer class="border-t border-subtle py-8 font-sans text-xs text-muted">
          <div class="flex flex-col justify-between gap-2 sm:flex-row">
            <p>
              MIT · Go + bubbletea · by
              <a
                href="https://arpitrajput.xyz"
                class="underline decoration-subtle underline-offset-2 hover:text-text"
                >Arpit Rajput</a
              >.
            </p>
            <div class="flex gap-6">
              <a href={repo} class="hover:text-text">github</a>
              <a href={`${repo}/releases`} class="hover:text-text">releases</a>
              <a href={`${repo}/issues`} class="hover:text-text">issues</a>
            </div>
          </div>
        </footer>
      </main>
    </div>

    <script is:inline>
      document.documentElement.classList.add("js");

      // Copy button
      const btn = document.getElementById("copy-btn");
      if (btn) {
        const icon = btn.querySelector("i");
        btn.addEventListener("click", async () => {
          const cmd = btn.getAttribute("data-copy") || "";
          try {
            await navigator.clipboard.writeText(cmd);
            if (icon) {
              icon.classList.remove("ti-clipboard-copy");
              icon.classList.add("ti-check");
              btn.classList.add("text-ok");
              setTimeout(() => {
                icon.classList.add("ti-clipboard-copy");
                icon.classList.remove("ti-check");
                btn.classList.remove("text-ok");
              }, 1500);
            }
          } catch (e) {
            if (icon) {
              icon.classList.remove("ti-clipboard-copy");
              icon.classList.add("ti-clipboard-x");
              setTimeout(() => {
                icon.classList.add("ti-clipboard-copy");
                icon.classList.remove("ti-clipboard-x");
              }, 1500);
            }
          }
        });
      }

      // Fade-in on scroll (styles gated behind .js in global.css)
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add("in");
              io.unobserve(e.target);
            }
          }
        },
        { threshold: 0.15 }
      );
      document.querySelectorAll(".reveal").forEach((el) => io.observe(el));
    </script>
  </body>
</html>
